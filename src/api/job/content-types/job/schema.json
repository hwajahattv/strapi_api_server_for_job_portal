{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "employer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::employer.employer"
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    },
    "budget": {
      "type": "decimal"
    },
    "work_mode": {
      "type": "enumeration",
      "enum": [
        "remote",
        "on-site",
        "hybrid"
      ]
    },
    "job_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job-request.job-request",
      "mappedBy": "job"
    },
    "job_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::job-type.job-type",
      "inversedBy": "jobs"
    },
    "job_status": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::job-status.job-status"
    }
  }
}
