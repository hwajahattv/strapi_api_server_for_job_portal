{
  "kind": "collectionType",
  "collectionName": "job_types",
  "info": {
    "singularName": "job-type",
    "pluralName": "job-types",
    "displayName": "Job Type"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "unique": true
    },
    "description": {
      "type": "text"
    },
    "is_active": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "integer"
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "job_type"
    }
  }
}
